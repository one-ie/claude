#!/usr/bin/env bash
# The TRACKED body of the git pre-commit hook. A3 of text/do-factory-plan.md.
#
# `.git/hooks/` is untracked and shared by every worktree of this repo, so the
# thing git actually executes is a generated SHIM
# (.claude/scripts/factory-secret-gate.sh --install writes it, from
# hooks/session-start.sh, idempotently). The shim execs THIS file. Keeping the
# body tracked is what makes the gate reviewable, diffable and portable; keeping
# the shim untracked is unavoidable, because git will not version .git/hooks.
#
# What it does: refuse a commit whose STAGED added lines contain a
# secret-shaped string. Staged, never `diff HEAD` — ten worktrees share this
# repo and a neighbour's unstaged file must never refuse your commit.
#
# It resolves the scanner NEXT TO ITSELF, so a tree always runs its own version
# of the pattern set rather than whatever the shim happened to pin. If the
# scanner is not there it REFUSES: an unrun gate is never a pass
# (.claude/rules/scripts.md — gate-run.sh exits 127 for exactly this reason).
set -uo pipefail

_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_gate="$_here/../../scripts/factory-secret-gate.sh"

if [ ! -r "$_gate" ]; then
  echo "[factory-secret-gate] REFUSING this commit: the scanner is missing." >&2
  echo "  looked for: $_gate" >&2
  echo "  An absent scanner is not a clean scan." >&2
  exit 5
fi

exec bash "$_gate" --scan --staged
